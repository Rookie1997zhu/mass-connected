# =============================================================================
# 云上部署环境变量模板（阿里云 ECS / Docker Compose）
# 用法：
#   cp .env.cloud.example .env
#   按下方「必改」项填实值后：docker compose up --build -d
# 注意：真实 .env 不要提交到 Git
# =============================================================================

# ---------- 站点访问（按你的公网 IP / 域名改）----------
# 当前 ECS 公网：8.213.135.51（韩国 ap-northeast-2）
CLOUD_PUBLIC_HOST=8.213.135.51
# Caddy 站点地址：写域名后才会自动 HTTPS；留空/不设则默认 :80 仅 HTTP
CADDY_SITE_ADDRESS=www.massconnected.com, massconnected.com

# ---------- Backend（必改）----------
# 生产必须换成强随机密钥（可用：openssl rand -hex 32）
# 若仍为 change-me-in-production / 弱默认值且 DEBUG=false，后端会拒绝启动
DJANGO_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

DJANGO_DEBUG=false

# Caddy 已终止 TLS 并对外提供 HTTPS 时设 true
DJANGO_SECURE_SSL=true

# 逗号分隔；务必包含公网 IP 或域名，以及 compose 内服务名
DJANGO_ALLOWED_HOSTS=www.massconnected.com,massconnected.com,8.213.135.51,localhost,127.0.0.1,backend,caddy

DB_HOST=mysql
DB_PORT=3306
DB_NAME=oem_db
DB_USER=oem_user
# 与下方 MYSQL_PASSWORD 保持一致；云上务必改成强密码
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

REDIS_URL=redis://redis:6379/0
REDIS_CELERY_URL=redis://redis:6379/1
REDIS_CHANNELS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

DEFAULT_LANGUAGE=ko
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# 浏览器实际访问来源（HTTPS 上线后用 https://）
CORS_ALLOWED_ORIGINS=https://www.massconnected.com,https://massconnected.com,http://8.213.135.51

MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# ---------- 阿里云 OSS 私有外存（仅云上开启；本地开发保持默认关）----------
# 控制台步骤摘要：
# 1) OSS 区域建议 ap-northeast-2（首尔），Bucket 读写权限选「私有」
# 2) RAM 子账号（编程访问）授本 Bucket Put/Get/Delete/List，拿到 AK/SK（勿提交 Git）
# 3) Bucket CORS：来源 https://www.massconnected.com,https://massconnected.com；
#    Methods GET,HEAD,PUT；暴露头 ETag,Content-Length
# 4) 填下方变量后重建/重启 backend 与 celery worker
# 5) 暂无自定义域名时不必改域名商 DNS；历史本地文件不迁移
USE_OSS=true
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=https://oss-ap-northeast-2.aliyuncs.com
OSS_REGION=ap-northeast-2
OSS_QUERYSTRING_EXPIRE=3600

# ---------- 第三方 Key（按需）----------
GEMINI_API_KEY=

# 博客 MCP 机器凭证（远程 HTTP /mcp/blog）；勿提交真实 Key
BLOG_MCP_API_KEY=
BLOG_MCP_AUTHOR_EMAIL=
OEM_API_BASE_URL=http://backend:8000/api

# 每日 YouTube→博客 流水线（默认关闭；开启前填关键词与 YOUTUBE_API_KEY）
CONTENT_PIPELINE_ENABLED=false
CONTENT_PIPELINE_DAILY_COUNT=10
CONTENT_PIPELINE_KEYWORDS=PCB制造,纸盒包装,OEM代工
CONTENT_PIPELINE_LANGUAGES=zh,ko
CONTENT_PIPELINE_SCHEDULE_CRON=0 9 * * *
CONTENT_PIPELINE_TIMEZONE=Asia/Shanghai
CONTENT_PIPELINE_AUTHOR_EMAIL=
YOUTUBE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 工作台参考汇率（exchangerate.host）；勿把真实 key 提交仓库
EXCHANGERATE_HOST_ACCESS_KEY=
EXCHANGERATE_HOST_BASE_URL=https://api.exchangerate.host
EXCHANGERATE_CACHE_TTL_SECONDS=86400

# ---------- 阿里云邮件推送（Direct Mail，新加坡区域）----------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtpdm-ap-southeast-1.aliyuncs.com
EMAIL_PORT=80
EMAIL_HOST_USER=hong@mail.massconnected.com
EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=MASS CONNECTED <hong@mail.massconnected.com>
FRONTEND_BASE_URL=https://www.massconnected.com

# ---------- 限流 ----------
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/min
THROTTLE_INQUIRY=10/min
THROTTLE_AI_TRANSLATE=20/min
THROTTLE_VERIFY_EMAIL=3/min

# ---------- Frontend / Admin（云上保持相对路径，一般不用改）----------
VITE_API_BASE_URL=/api
VITE_ADMIN_BASE_PATH=/admin

# ---------- MySQL（必改密码）----------
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD
MYSQL_DATABASE=oem_db
MYSQL_USER=oem_user
MYSQL_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

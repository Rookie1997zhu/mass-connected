{
  "$schema": "https://caddyserver.com/docs/json/config/",
  "admin": {"disabled": true},
  "apps": {
    "http": {
      "servers": {
        "main": {
          "listen": [":80"],
          "routes": [
            {
              "match": [{"path": ["/api", "/api/*"]}],
              "handle": [{"handler": "reverse_proxy", "upstreams": [{"dial": "backend:8000"}]}]
            },
            {
              "match": [{"path": ["/media/*"]}],
              "handle": [{"handler": "file_server", "root": "/media"}]
            },
            {
              "match": [{"path": ["/admin", "/admin/*"]}],
              "handle": [{"handler": "reverse_proxy", "upstreams": [{"dial": "admin:5174"}]}]
            },
            {
              "handle": [{"handler": "reverse_proxy", "upstreams": [{"dial": "frontend:5173"}]}]
            }
          ]
        }
      }
    }
  }
}

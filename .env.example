# Backend
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,caddy
DB_HOST=mysql
DB_PORT=3306
DB_NAME=oem_db
DB_USER=oem_user
DB_PASSWORD=oem_pass
REDIS_URL=redis://redis:6379/0
DEFAULT_LANGUAGE=ko
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://localhost:5174
# 局域网访问时 API 走 Caddy 同源 /api，一般无需额外 CORS；若直连后端可在此追加 http://<本机IP>
MEDIA_ROOT=/app/media
MEDIA_URL=/media/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend / Admin — 使用相对路径 /api，局域网通过本机 IP 访问时 API 自动走同一主机
VITE_API_BASE_URL=/api

# Admin
VITE_ADMIN_BASE_PATH=/admin

# MySQL
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=oem_db
MYSQL_USER=oem_user
MYSQL_PASSWORD=oem_pass

# Backend
# 生产必须替换为强随机密钥；DJANGO_DEBUG=false 时若仍为弱默认值，进程将拒绝启动
DJANGO_SECRET_KEY=change-me-in-production
# 本地开发可设 true；示例与生产默认建议 false
DJANGO_DEBUG=false
# 仅在反向代理已终止 TLS 时设 true（启用 HSTS / Secure Cookie / SSL redirect）
DJANGO_SECURE_SSL=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,caddy
DB_HOST=mysql
DB_PORT=3306
DB_NAME=oem_db
DB_USER=oem_user
DB_PASSWORD=oem_pass
REDIS_URL=redis://redis:6379/0
DEFAULT_LANGUAGE=ko
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://localhost:5174
# 局域网访问时 API 走 Caddy 同源 /api，一般无需额外 CORS；若直连后端可在此追加 http://<本机IP>
MEDIA_ROOT=/app/media
MEDIA_URL=/media/
# 本地开发默认关 OSS（走本地盘）。云上见 .env.cloud.example（USE_OSS=true）
# USE_OSS=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 博客 MCP 机器凭证（远程 HTTP）；勿提交真实 Key
BLOG_MCP_API_KEY=
BLOG_MCP_AUTHOR_EMAIL=
OEM_API_BASE_URL=http://backend:8000/api

# 每日 YouTube→博客 流水线（默认关闭）
CONTENT_PIPELINE_ENABLED=false
CONTENT_PIPELINE_DAILY_COUNT=10
CONTENT_PIPELINE_KEYWORDS=PCB制造,纸盒包装,OEM代工
CONTENT_PIPELINE_LANGUAGES=zh,ko
CONTENT_PIPELINE_SCHEDULE_CRON=0 9 * * *
CONTENT_PIPELINE_TIMEZONE=Asia/Shanghai
CONTENT_PIPELINE_AUTHOR_EMAIL=
YOUTUBE_API_KEY=

# 工作台参考汇率（exchangerate.host）；勿将真实 key 提交仓库
EXCHANGERATE_HOST_ACCESS_KEY=
EXCHANGERATE_HOST_BASE_URL=https://api.exchangerate.host
EXCHANGERATE_CACHE_TTL_SECONDS=86400

# 阿里云邮件推送（本地联调可改 console 后端：django.core.mail.backends.console.EmailBackend）
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtpdm-ap-southeast-1.aliyuncs.com
EMAIL_PORT=80
EMAIL_HOST_USER=hong@mail.massconnected.com
EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=MASS CONNECTED <hong@mail.massconnected.com>
FRONTEND_BASE_URL=http://localhost

# 接口限流（DRF ScopedRateThrottle / AnonRateThrottle）
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/min
THROTTLE_INQUIRY=10/min
THROTTLE_AI_TRANSLATE=20/min
THROTTLE_VERIFY_EMAIL=3/min

# Frontend / Admin — 使用相对路径 /api，局域网通过本机 IP 访问时 API 自动走同一主机
VITE_API_BASE_URL=/api

# Admin
VITE_ADMIN_BASE_PATH=/admin

# MySQL
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=oem_db
MYSQL_USER=oem_user
MYSQL_PASSWORD=oem_pass
